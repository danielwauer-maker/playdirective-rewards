# Public application
PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
ENVIRONMENT=development

# Database
POSTGRES_DB=playdirective_rewards
POSTGRES_USER=playdirective
POSTGRES_PASSWORD=playdirective
DATABASE_URL=postgresql+psycopg://playdirective:playdirective@postgres:5432/playdirective_rewards

# Authentication — replace in every real environment
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=30
MAGIC_LINK_MINUTES=20

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=PlayDirective Rewards <noreply@example.com>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_CURRENCY=eur

# Referral launch defaults
REFERRAL_REWARD_CENTS=500
REFERRAL_MIN_PAYMENT_CENTS=499

# Operator
ADMIN_EMAIL=
